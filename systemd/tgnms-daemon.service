[Unit]
Description=TGNMS Daemon Service
Documentation=https://confluence.company.local/tgnms/service-docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgnms
Group=tgnms
WorkingDirectory=/opt/tgnms
ExecStart=/opt/tgnms/venv/bin/python /opt/tgnms/main.py
Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
LogNamespace=tgnms
# Optional syslog forwarding
ForwardToSyslog=yes

Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/opt/tgnms/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"

# Limits
LimitNOFILE=65536
LimitNPROC=1024
TimeoutStopSec=15
OOMScoreAdjust=-100

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
NoNewPrivileges=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true

ReadOnlyPaths=/
ReadWritePaths=/opt/tgnms/logs /opt/tgnms/data

# Drop unnecessary privileges
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
